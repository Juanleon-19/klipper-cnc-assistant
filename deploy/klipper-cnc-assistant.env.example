# Safe deployment defaults.
#
# Copy this file to:
#   /etc/klipper-cnc-assistant/klipper-cnc-assistant.env
# and edit that external file locally. Never commit the operational copy.
#
# Physical mode, automatic connection, serial ports, machine coordinates,
# references, tool-change positions and motion limits must be configured only
# after supervised validation on the actual machine.

MACHINE_MODE=simulated
MACHINE_AUTO_CONNECT=false
MOONRAKER_URL=http://127.0.0.1:7126
MOONRAKER_WS=ws://127.0.0.1:7126/websocket
SERIAL_BAUDRATE=115200
